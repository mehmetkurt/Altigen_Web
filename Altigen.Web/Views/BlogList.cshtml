@using Examine
@using Umbraco.Cms.Core.Web
@using Umbraco.Extensions
@using Altigen.Web.Extensions
@inject Umbraco.Cms.Core.IPublishedContentQuery PublishedContentQuery
@inject Examine.IExamineManager ExamineManager
@model BlogList
@using System

@{
    Layout = "SubLayout.cshtml";

    // 1. Get Categories (Children of BlogList)
    var categories = Model.Children<BlogCategory>()?
        .Where(x => x.IsVisible() && x.Children<Blog>().Any())
        .ToList() ?? new List<BlogCategory>();

    // 2. Get All Posts (Children of Categories)
    var allPosts = new List<Altigen.Web.Models.Blog>();
    
    // We create a dictionary to map Post ID to Category UrlSegment (for filtering class)
    var postCategoryMap = new Dictionary<int, string>();
    var categoryNameMap = new Dictionary<string, string>(); // slug -> name

    foreach (var category in categories)
    {
        var catSlug = category.UrlSegment() ?? string.Empty;
        if(!string.IsNullOrEmpty(catSlug)) {
             categoryNameMap[catSlug] = category.Name;
        }

        var posts = category.Children<Blog>()?
            .Where(x => x.IsVisible())
            .ToList();
            
        if (posts != null)
        {
            foreach(var post in posts)
            {
                allPosts.Add(post);
                postCategoryMap[post.Id] = catSlug;
            }
        }
    }

    // 3. Filter by Tag
    var activeTag = Context.Request.Query["tag"].ToString();
    IEnumerable<IPublishedContent> filteredPosts = allPosts;

    if (!string.IsNullOrEmpty(activeTag))
    {
        filteredPosts = filteredPosts.Where(post => {
            var tags = post.Value<IEnumerable<string>>("blogTags");
            return tags != null && tags.Contains(activeTag, StringComparer.InvariantCultureIgnoreCase);
        });
    }

    // Order by Date
    filteredPosts = filteredPosts.OrderByDescending(x => x.CreateDate).ToList();

    // 4. Paging Logic
    var pagingConfig = Model.GetEffectivePagingConfig();
    int pageNumber = 1;
    if (!int.TryParse(Context.Request.Query["page"], out pageNumber)) pageNumber = 1;
    if (pageNumber < 1) pageNumber = 1;

    var totalItems = filteredPosts.Count();
    var pagedPosts = filteredPosts.Skip((pageNumber - 1) * pagingConfig.PageSize).Take(pagingConfig.PageSize).ToList();

    // 5. Prepare ViewModel List (Use pagedPosts instead of filteredPosts)
    var blogItems = pagedPosts.Select(post => 
    {
        var catSlug = postCategoryMap.ContainsKey(post.Id) ? postCategoryMap[post.Id] : "";
        var catName = categoryNameMap.ContainsKey(catSlug) ? categoryNameMap[catSlug] : "";
        return new BlogItemViewModel 
        {
            Post = (Blog)post,
            CategorySlug = catSlug,
            CategoryName = catName
        };
    });
}

@section Head {
    <link rel="stylesheet" href="/assets/styles/bloglist.css" />
}

<div class="blog-list-page container">
    
    @* Page Header Area: Filter Toolbar *@
    <div class="blog-controls mb-5">
        
        @* Active Tag Banner *@
        @if (!string.IsNullOrEmpty(activeTag))
        {
            <div class="alert alert-light border shadow-sm d-flex align-items-center justify-content-between mb-4 fade show" role="alert">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <span class="mso">filter_alt</span>
                    </div>
                    <div>
                        <p class="mb-0 text-muted small">
                            <strong class="text-primary">@activeTag</strong> etiketine sahip <strong>@totalItems</strong> kayıt gösteriliyor.
                        </p>
                    </div>
                </div>
                <a href="@Model.Url()" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-2 border-0 bg-danger bg-opacity-10 text-danger" title="Filtreyi Temizle">
                    <span class="d-none d-sm-inline fw-medium">Filtreyi Kaldır</span>
                    <span class="d-inline d-sm-none fw-medium">Temizle</span>
                    <span class="mso">close</span>
                </a>
            </div>
        }

        <div class="row align-items-center justify-content-end">
            @if (categories.Any())
            {
                <div class="col-12">
                    <div class="filter-toolbar d-flex flex-wrap gap-2 justify-content-end">
                        <a href="@Model.Url()" class="btn btn-filter @(string.IsNullOrEmpty(activeTag) ? "active" : "")">Tümü</a>
                        @foreach (var category in categories)
                        {
                             <a href="@category.Url()" class="btn btn-filter">@category.Name</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* Blog Grid *@
    @await Html.PartialAsync("~/Views/Partials/Blog/_BlogGrid.cshtml", blogItems)

    @* Pager *@
    @await Html.PartialAsync("~/Views/Partials/Common/_Pager.cshtml", new Altigen.Web.Models.PagerViewModel
    {
        Config = pagingConfig,
        TotalItems = totalItems,
        CurrentPage = pageNumber,
        UrlFormat = string.IsNullOrEmpty(activeTag) ? "?page={0}" : $"?tag={activeTag}&page={{0}}"
    })

</div>