
@model FooterViewModel

<footer>
    <div class="container">
        <div class="row gy-5 gx-0 gx-lg-5">
            <!-- Company Info & Logo -->
            <div class="col-lg-3 col-md-6">
                <div class="footer-logo">
                    @await Component.InvokeAsync("Logo", new { logo = Model.Logo })
                </div>
                <p class="text-white-50">@Model.Description</p>
                <div class="social-links">
                     @await Html.PartialAsync("~/Views/Shared/Components/Footer/_SocialLinks.cshtml", Model.SocialIcons)
                </div>
            </div>

            <!-- Quick Links -->
            <div class="col-lg-6 col-md-6">
                @await Component.InvokeAsync("FooterMenu")
            </div>

            <!-- Contact Info -->
            <div class="col-lg-3 col-md-12">
                <h5>İletişim</h5>
                <ul class="contact-info">
                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        <li>
                            <span class="mso">location_on</span>
                            <div>
                                <strong>Adres</strong>
                                <span class="text-white-50">@Model.Address</span>
                            </div>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <li>
                            <span class="mso">phone</span>
                            <div>
                                <strong>Telefon</strong>
                                <a href="tel:@Model.Phone.Replace(" ", "").Replace("(", "").Replace(")", "")">@Model.Phone</a>
                            </div>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <li>
                            <span class="mso">mail</span>
                            <div>
                                <strong>E-posta</strong>
                                <a href="mailto:@Model.Email">@Model.Email</a>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Footer Bottom -->
        <div class="footer-bottom">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="copyright">&copy; @DateTime.Now.Year Altigen Dijital. Tüm hakları saklıdır.</p>
                </div>
                <div class="col-md-6">
                    <div class="bottom-links">
                        @if (Model.PrivacyPolicy != null)
                        {
                            <a href="@Model.PrivacyPolicy.Url()">@Model.PrivacyPolicy.Name</a>
                        }
                        @if (Model.CookiePolicy != null)
                        {
                            <a href="@Model.CookiePolicy.Url()">@Model.CookiePolicy.Name</a>
                        }
                        @if (Model.Gdpr != null)
                        {
                            <a href="@Model.Gdpr.Url()">@Model.Gdpr.Name</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
