@model IPublishedContent

@{
    var sliderItems = Model.Value<BlockListModel>("sliderItems");
    if (sliderItems == null || !sliderItems.Any()) return;
}
<link rel="stylesheet" href="/assets/styles/main-slider.css" />
<div class="main-slider-container position-relative">
    <div class="swiper main-slider">
        <div class="swiper-wrapper">
            @foreach (var block in sliderItems)
            {
                var content = block.Content;
                var sliderItem = content as SliderItem; // Attempt to cast for strong typing if models are generated
                
                // Fallback to Value<T> if casting fails or direct property access isn't available
                var image = sliderItem?.SliderItemImage ?? content.Value<MediaWithCrops>("sliderItemImage");
                var mobileImage = sliderItem?.SliderItemMobileImage ?? content.Value<MediaWithCrops>("sliderItemMobileImage");
                
                var imageUrl = image?.GetCropUrl(width: 1920, height: 1080) ?? ""; // Default desktop size
                var mobileImageUrl = mobileImage?.GetCropUrl(width: 768, height: 1024) ?? ""; // Default mobile size
                
                var title = sliderItem?.SliderItemTitle ?? content.Value<string>("sliderItemTitle");
                var description = sliderItem?.SliderItemDescription ?? content.Value<string>("sliderItemDescription");
                // Link property is removed from model, replaced by Buttons (not implemented in view yet)
                var bgClass = "bg-dark";

                <div class="swiper-slide d-flex align-items-center justify-content-center @bgClass text-white position-relative overflow-hidden">
                    
                    @* Responsive Background Image *@
                    <div class="position-absolute top-0 start-0 w-100 h-100 z-0">
                        <picture>
                             @if (!string.IsNullOrEmpty(mobileImageUrl))
                            {
                                <source media="(max-width: 768px)" srcset="@mobileImageUrl" />
                            }
                            <img src="@imageUrl" alt="@title" class="w-100 h-100 object-fit-cover" />
                        </picture>
                    </div>

                    <div class="slider-overlay z-1"></div>
                    
                    <div class="container text-center position-relative z-2">
                        @if (!string.IsNullOrEmpty(title))
                        {
                            <h1 class="display-5 fw-bold mb-3">@title</h1>
                        }
                        @if (!string.IsNullOrEmpty(description))
                        {
                            <p class="lead mb-5">@description</p>
                        }
                        @if (sliderItem?.SliderItemButtons != null && sliderItem.SliderItemButtons.Any())
                        {
                            @await Html.PartialAsync("_SliderButtons", sliderItem)
                        }
                    </div>
                </div>
            }
        </div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
    </div>
    @await Html.PartialAsync("_SliderThumbnails", sliderItems)
</div>
