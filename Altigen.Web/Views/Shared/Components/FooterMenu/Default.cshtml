
@model IPublishedContent

@if (Model == null)
{
    return;
}

@{
    var menuItems = Model.Value<IEnumerable<BlockListItem>>("menuItems");
}

@if (menuItems != null && menuItems.Any())
{
    @* Check if we have any column headers to decide structure *@
    bool hasColumns = menuItems.Any(x => x.Content.Value<bool>("isColumnHeader"));
    
    if (hasColumns) 
    {
        @* If mixed or purely columns, we loop and render blocks *@
        <div class="row gy-4">
            @foreach (var item in menuItems)
            {
                var content = item.Content;
                var title = content.Value<string>("title");
                var link = content.Value<Link>("link");
                var isColHeader = content.Value<bool>("isColumnHeader");
                var subItems = content.Value<IEnumerable<BlockListItem>>("subItems");
                var iconCssClass = content.Value<string>("iconCssClass");

                var collapseId = $"footer_collapse_{Guid.NewGuid().ToString("N")}";

                <div class="col-12 col-lg-6">
                    @if (isColHeader)
                    {
                        <div class="footer-column-group">
                            <h5 class="text-white text-uppercase fw-bold mb-3 footer-collapse-header" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#@collapseId" 
                                aria-expanded="false" 
                                aria-controls="@collapseId">
                                 @if (!string.IsNullOrEmpty(iconCssClass))
                                {
                                    <i class="@iconCssClass me-2"></i>
                                }
                                @title
                                <span class="mso toggle-icon d-md-none float-end">expand_more</span>
                            </h5>
                            @if (subItems != null && subItems.Any())
                            {
                                 <div class="collapse footer-collapse-content" id="@collapseId">
                                     <ul class="footer-menu">
                                        @foreach(var subItem in subItems)
                                        {
                                            var subContent = subItem.Content;
                                            var subTitle = subContent.Value<string>("title");
                                            var subLink = subContent.Value<Link>("link");
                                            var subIcon = subContent.Value<string>("iconCssClass");
                                            var subUrl = subLink?.Url ?? "#";
                                            var subTarget = subLink?.Target ?? "_self";
    
                                            <li>
                                                <a href="@subUrl" target="@subTarget">
                                                    @if (!string.IsNullOrEmpty(subIcon))
                                                    {
                                                        <i class="@subIcon me-2"></i>
                                                    }
                                                    <span class="mso">chevron_right</span> @subTitle
                                                </a>
                                            </li>
                                        }
                                     </ul>
                                 </div>
                            }
                        </div>
                    }
                    else
                    {
                        @* Fallback for root items that are NOT headers - Just render them as a generic list, likely user won't mix but good to handle *@
                        <ul class="footer-menu mb-0">
                             @{
                                var url = link?.Url ?? "#";
                                var target = link?.Target ?? "_self";
                             }
                             <li>
                                <a href="@url" target="@target">
                                    @if (!string.IsNullOrEmpty(iconCssClass))
                                    {
                                        <i class="@iconCssClass me-2"></i>
                                    }
                                    <span class="mso">chevron_right</span> @title
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            }
        </div>
    }
    else
    {
        @* Original flat list behavior if no column headers exist *@
        <ul class="footer-menu">
            @foreach (var item in menuItems)
            {
                var content = item.Content;
                var title = content.Value<string>("title");
                var link = content.Value<Link>("link");
                var iconCssClass = content.Value<string>("iconCssClass");
                var url = link?.Url ?? "#";
                var target = link?.Target ?? "_self";

                <li>
                    <a href="@url" target="@target">
                         @if (!string.IsNullOrEmpty(iconCssClass))
                        {
                            <i class="@iconCssClass me-2"></i>
                        }
                        <span class="mso">chevron_right</span> @title
                    </a>
                </li>
            }
        </ul>
    }
}
