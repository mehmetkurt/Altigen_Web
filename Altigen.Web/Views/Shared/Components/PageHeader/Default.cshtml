@model IPageHeader

@{
    var content = Model as IPublishedContent;

    if (content == null)
        return;

    var headerTitle = Model.PageHeaderTitle;
    if (string.IsNullOrWhiteSpace(headerTitle)) headerTitle = "";

    var headerSubtitle = Model.PageHeaderSubtitle;
    if (string.IsNullOrWhiteSpace(headerSubtitle)) headerSubtitle = "";

}

<div class="page-header">
    <div class="container">
        <div class="row">
            <div class="col-12">
                @if (!string.IsNullOrWhiteSpace(headerSubtitle))
                {
                    <h1 class="page-header-title">@headerTitle</h1>
                }

                @if (!string.IsNullOrWhiteSpace(headerSubtitle))
                {
                    <p class="page-header-subtitle">@headerSubtitle</p>
                }

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        @{
                            var ancestors = content.Ancestors().Reverse().ToList();
                            var root = ancestors.FirstOrDefault();
                        }

                        @if (root != null)
                        {
                            var rootTitle = root is ISeo seoRoot ? seoRoot.SeoPageBreadcrumbTitle : null;
                            if (string.IsNullOrWhiteSpace(rootTitle)) rootTitle = root.Name;
                            <li class="breadcrumb-item">
                                <a href="@root.Url()" title="@rootTitle">
                                    <span class="mso">home</span>
                                </a>
                            </li>
                        }

                        @foreach (var item in ancestors.Skip(1))
                        {
                            var title = item is ISeo seoItem ? seoItem.SeoPageBreadcrumbTitle : null;
                            if (string.IsNullOrWhiteSpace(title)) title = item.Name;
                            <li class="breadcrumb-item"><a href="@item.Url()" title="@title">@title</a></li>
                        }
                        @{
                            var currentTitle = content is ISeo seo ? seo.SeoPageBreadcrumbTitle : null;
                            if (string.IsNullOrWhiteSpace(currentTitle)) currentTitle = content.Name;
                        }
                        <li class="breadcrumb-item active" aria-current="page">
                            @if (content.Level == 1)
                            {
                                <span class="mso">home</span>
                            }
                            else
                            {
                                @currentTitle
                            }
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
