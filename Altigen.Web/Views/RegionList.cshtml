@model RegionList
@using Umbraco.Cms.Core.Models.PublishedContent
@using Altigen.Web.Models
@using Umbraco.Extensions

@{
    Layout = "PagingListLayout.cshtml";

    var categories = Model.Children<RegionCategory>()?
        .Where(x => x.IsVisible())
        .ToList() ?? new List<RegionCategory>();

    var totalItems = categories.Count();

    var pagingConfig = Model.GetEffectivePagingConfig();
    var pageSize = pagingConfig.PageSize;
    var pageNumber = 1;

    if (!int.TryParse(Context.Request.Query["page"], out pageNumber)) pageNumber = 1;

    var pagedItems = categories.Skip((pageNumber - 1) * pageSize).Take(pageSize).ToList();
    
    var pagerUrlFormat = "?page={0}";
}

@section Head {
    <link rel="stylesheet" href="~/assets/styles/region-list.css" />
}

@section Scripts {
    <script src="~/sources/js/region-list.js"></script>
}

<div class="region-list-page">
        @if (pagedItems.Any())
        {
             @await Html.PartialAsync("~/Views/Partials/Region/_RegionGrid.cshtml", pagedItems.OfType<IPublishedContent>())
        }
        else
        {
             <div class="alert alert-info">
                <span>Henüz eklenmiş bir bölge kategorisi bulunmuyor.</span>
             </div>
        }

        @await Html.PartialAsync("~/Views/Partials/Common/_Pager.cshtml", new PagerViewModel
        {
            Config = pagingConfig,
            TotalItems = totalItems,
            CurrentPage = pageNumber,
            UrlFormat = pagerUrlFormat
        })
</div>