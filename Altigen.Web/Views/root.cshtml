
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Force Theme Color in both Light and Dark modes -->
    <meta name="theme-color" content="#08223a" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#08223a" media="(prefers-color-scheme: dark)">
    <!-- For iOS -->
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    @await Component.InvokeAsync("Seo", new { content = Model })
    @await Html.PartialAsync("_Styles")
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @await Component.InvokeAsync("Header")
    <main class="main-wrapper">
        @RenderBody()
    </main>
    @await Component.InvokeAsync("Footer")
    @await Html.PartialAsync("_WhatsApp")
    @await Html.PartialAsync("_Scripts")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>