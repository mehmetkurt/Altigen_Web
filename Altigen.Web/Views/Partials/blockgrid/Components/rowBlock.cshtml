@using Umbraco.Cms.Core.Models.Blocks
@using Altigen.Web.Core.HtmlHelpers
@model BlockGridItem
@{
    if (Model?.Areas.Any() != true) { return; }
    var settings = Model.Settings as BlockSettingsModel;
}
<div class="row-block-wrapper @Html.GetUniqueBlockClass(Model) @settings.GetBlockAlignmentClass()">
    <div class="row">
        @await Html.GetBlockGridItemAreasHtmlAsync(Model)
    </div>
</div>