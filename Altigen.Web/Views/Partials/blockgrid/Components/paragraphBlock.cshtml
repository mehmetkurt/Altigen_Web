@using Umbraco.Cms.Core.Models.Blocks
@using Altigen.Web.Core.HtmlHelpers
@model BlockGridItem<ParagraphBlock>
@{
    var content = Model.Content.ParagraphBlockContent;
    var settings = Model.Settings as BlockSettingsModel;
}

@if (content != null && !string.IsNullOrWhiteSpace(content.ToString()))
{
    <div class="paragraph-block @Html.GetUniqueBlockClass(Model) @settings.GetBlockAlignmentClass()">
        @content
    </div>
}
