@using Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Cms.Core.Models.Blocks
@using Altigen.Web.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem<ParagraphBlock>>
@{
    var content = Model.Content.ParagraphBlockContent;
    var settings = Model.Settings as BlockSettingsModel;
}

@if (content != null && !string.IsNullOrWhiteSpace(content.ToString()))
{
    <div class="paragraph-block @settings.GetBlockAlignmentClass()" style="@settings.GetBlockStyles()">
        @content
    </div>
}
