@using Umbraco.Cms.Core.Models.Blocks
@using Altigen.Web.Extensions
@using CodeIsLife.Elements.Helpers
@using Altigen.Web.Core.HtmlHelpers
@model BlockGridItem<ImageBlock>
@{
    var image = Model.Content.ImageBlockImage;
    var altText = Model.Content.ImageBlockAltText;
    var title = Model.Content.ImageBlockTitle;
    
    // Loading Strategy
    var loadingStrategy = "lazy";
    var loadingVal = Model.Content.ImageBlockLoading;
    if (!string.IsNullOrEmpty(loadingVal))
    {
        if (loadingVal.Equals("none", StringComparison.OrdinalIgnoreCase)) 
        {
            loadingStrategy = null; 
        }
        else if (loadingVal.Equals("eager", StringComparison.OrdinalIgnoreCase))
        {
            loadingStrategy = "eager";
        }
    }

    var settings = Model.Settings as BlockSettingsModel;
    var alignmentClass = settings?.GetBlockAlignmentClass();
    var uniqueClass = Html.GetUniqueBlockClass(Model);
}

@if (image != null)
{
    var attrs = new Dictionary<string, object>
    {
        { "alt", altText ?? "" },
        { "class", "altigen-image " + alignmentClass + " " + uniqueClass }
    };
    
    if (!string.IsNullOrEmpty(title)) attrs.Add("title", title);
    if (loadingStrategy != null) attrs.Add("loading", loadingStrategy);

    <img src="@image.Url()" @foreach(var attr in attrs){ <text>@attr.Key="@attr.Value" </text> } />
}
