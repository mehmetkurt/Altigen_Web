@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@model IEnumerable<MediaWithCrops>

@{
    if (Model == null || !Model.Any()) return;

    var images = Model.ToList();
    var isGallery = images.Count > 1;
}

@if (isGallery)
{
    <div class="blog-gallery-container mb-5">
        <div id="blog-gallery-slider" class="swiper">
            <div class="swiper-wrapper" id="blog-lightgallery">
                @foreach (var img in images)
                {
                    <a href="@Html.Raw(img.GetCropUrl(width: 1600))" 
                       class="swiper-slide gallery-item shadow-sm rounded-3 overflow-hidden position-relative d-block"
                       data-src="@Html.Raw(img.GetCropUrl(width: 1600))">
                        
                        <img src="@Html.Raw(img.GetCropUrl(height: 500, imageCropMode: ImageCropMode.Max))" 
                             alt="@img.Name" 
                             loading="lazy"
                             class="transition-transform" />
                        
                        <div class="gallery-overlay">
                            <i class="bi bi-zoom-in text-white fs-2"></i>
                        </div>
                    </a>
                }
            </div>
            <div class="swiper-pagination d-lg-none mt-4"></div>
        </div>
    </div>
}
else
{
    @* Single Hero Image *@
    var mainImage = images.First();
    <div class="blog-detail-hero mb-4 rounded-3 overflow-hidden shadow-sm">
        <img src="@mainImage.GetCropUrl(1200, 600)" alt="@mainImage.Name" class="img-fluid" />
    </div>
}
