@model TocResult

@if (Model != null && Model.Items.Any())
{
    @* Collapsible TOC (Accordion) *@
    <div class="mb-5 mobile-toc-wrapper">
        <details class="mobile-toc border rounded-3 bg-white">
            <summary class="p-3 fw-bold d-flex align-items-center justify-content-between cursor-pointer list-style-none">
                <span class="text-uppercase ls-1">İçindekiler</span>
                <span class="mso transition-transform">keyboard_arrow_down</span>
            </summary>
            <nav class="toc-content p-3 pt-0 border-top-0">
                <ul class="nav flex-column gap-1">
                    @foreach (var item in Model.Items)
                    {
                        var levelClass = $"toc-level-{item.Level}";
                        
                        <li class="nav-item">
                            <a class="nav-link py-1 text-secondary @levelClass" href="#@item.Id">
                                @item.Title
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </details>
    </div>
}
