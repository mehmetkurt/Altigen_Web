@using Altigen.Web.Models
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@model Region
@inject Altigen.Web.Core.Services.IRegionService RegionService



@{
    Layout = "SubLayout.cshtml"; 
    var mainImage = Model.RegionFeaturedImages?.FirstOrDefault();
    var relatedServices = RegionService.GetRelatedServicesInLocation(Model);
}

@section Head {
     <link rel="stylesheet" href="~/assets/styles/region-detail.css" />
}

<div class="region-detail">
    <div class="row">
        <div class="col-lg-8">
            @if (mainImage != null)
            {
                <div class="mb-4 rounded-3 overflow-hidden shadow-sm">
                    <img src="@mainImage.GetCropUrl(width: 850, height: 450)" 
                         alt="@Model.Name" 
                         class="img-fluid w-100 object-fit-cover"
                         width="850" loading="eager" />
                </div>
            }



            <div class="rich-text content-body mb-5">
                @Model.RegionContent
            </div>

            @{
                var category = Model.Parent<RegionCategory>();
                var otherDistricts = new List<IPublishedContent>();
                
                if (category != null)
                {
                    var categoryLocations = RegionService.GetLocationsForCategory(category);
                    var allDistricts = categoryLocations.Districts;

                    var currentDistricts = new List<int>();
                    if (Model.RegionLocation != null)
                    {
                        foreach (var loc in Model.RegionLocation)
                        {
                            if (loc.ContentType.Alias == Altigen.Web.Models.District.ModelTypeAlias)
                            {
                                currentDistricts.Add(loc.Id);
                            }
                            else if (loc.ContentType.Alias == Altigen.Web.Models.Neighborhood.ModelTypeAlias)
                            {
                                var parent = loc.Parent();
                                if (parent != null && parent.ContentType.Alias == Altigen.Web.Models.District.ModelTypeAlias)
                                {
                                    currentDistricts.Add(parent.Id);
                                }
                            }
                        }
                    }

                    otherDistricts = allDistricts
                        .Where(x => !currentDistricts.Contains(x.Id))
                        .OrderBy(x => x.Name)
                        .ToList();
                }
            }

            @if (otherDistricts.Any())
            {
                <div class="other-service-areas mb-5">
                    <h4 class="heading-decorated">Hizmet Verilen Diğer Bölgeler</h4>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        @foreach (var dist in otherDistricts)
                        {
                            // Find a sibling region that covers this district
                            var targetRegion = category?.Children<Region>()?
                                .FirstOrDefault(r => r.RegionLocation != null && r.RegionLocation.Any(l => l.Id == dist.Id || l.IsDescendantOrSelf(dist) || dist.IsDescendantOrSelf(l)));
                            
                            var url = targetRegion?.Url() ?? "#";
                            
                            if (targetRegion != null)
                            {
                                <a href="@url" class="district-tag">
                                    @dist.Name
                                </a>
                            }
                        }
                    </div>

                </div>
            }


             
             @* Description Fallback if Content is empty *@
             @if(Model.RegionContent == null || string.IsNullOrWhiteSpace(Model.RegionContent.ToString()))
             {
                  <div class="lead">
                      @Model.RegionDescription
                  </div>
             }

        </div>

        <div class="col-lg-4">
            <div class="sticky-top" style="top: 10rem; z-index: 10;">
                <div class="card border-0 shadow-sm bg-white mb-4">
                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold mb-3">Bilgi</h5>
                        <p class="card-text text-muted mb-0">
                            Bu bölge ile ilgili detaylı bilgi almak veya hizmet talebinde bulunmak için bizimle iletişime geçebilirsiniz.
                        </p>
                        <a href="/iletisim" class="btn btn-primary w-100 mt-3 rounded-pill fw-bold">
                            İletişime Geç
                        </a>
                    </div>
                </div>

                @if(Model.RegionLocation != null && Model.RegionLocation.Any())
                {
                    <div class="card border-0 shadow-sm bg-white mb-4">
                        <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                            <h5 class="card-title fw-bold mb-0 d-flex align-items-center gap-2">
                                <span class="mso text-primary">location_on</span>
                                Hizmet Bölgeleri
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush p-3">
                                @foreach(var loc in Model.RegionLocation)
                                {
                                    <a href="@GetLocationFilterUrl(Model.Parent(), loc)" class="list-group-item list-group-item-action d-flex gap-3 py-3 border-0 rounded-4 mb-1 text-decoration-none">
                                        <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle flex-shrink-0" style="width: 40px; height: 40px;">
                                            <span class="mso text-primary fs-5">near_me</span>
                                        </div>
                                        <div class="d-flex gap-2 w-100 justify-content-between">
                                            <div>
                                                <h6 class="mb-0 fw-semibold text-dark">@loc.Name</h6>
                                                <p class="mb-0 opacity-75 small text-muted">Hizmet Bölgesi</p>
                                            </div>
                                            @{ var parent = loc.Parent(); }
                                            @if (parent != null)
                                            {
                                                <small class="opacity-50 text-nowrap text-secondary">@parent.Name</small>
                                            }
                                        </div>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (relatedServices != null && relatedServices.Any())
                {
                    <div class="card border-0 shadow-sm bg-white mb-4">
                        <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                            <h5 class="card-title fw-bold mb-0 d-flex align-items-center gap-2">
                                <span class="mso text-primary">layers</span>
                                Bölgedeki Diğer Hizmetler
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush p-3">
                                @foreach(var item in relatedServices)
                                {
                                    <a href="@item.Url()" class="list-group-item list-group-item-action d-flex gap-3 py-3 border-0 rounded-4 mb-1 text-decoration-none">
                                        <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle flex-shrink-0" style="width: 40px; height: 40px;">
                                            <span class="mso text-primary fs-5">arrow_forward</span>
                                        </div>
                                        <div class="d-flex flex-column justify-content-center">
                                            <h6 class="mb-0 fw-semibold text-dark">@item.Parent()?.Name</h6>
                                            <p class="mb-0 opacity-75 small text-muted">Hizmet</p>
                                        </div>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>

    </div>
</div>

@functions {
    public string GetLocationFilterUrl(IPublishedContent? regionPageParent, IPublishedContent loc)
    {
        var categoryUrl = regionPageParent?.Url();
        if (string.IsNullOrEmpty(categoryUrl)) return "#";

        var parent = loc.Parent();
        if (loc.ContentType.Alias == Altigen.Web.Models.Neighborhood.ModelTypeAlias && parent != null)
        {
            return $"{categoryUrl}?district={parent.UrlSegment()}&neighborhood={loc.UrlSegment()}";
        }
        else if (loc.ContentType.Alias == Altigen.Web.Models.District.ModelTypeAlias)
        {
            return $"{categoryUrl}?district={loc.UrlSegment()}";
        }
        
        return categoryUrl;
    }
}
