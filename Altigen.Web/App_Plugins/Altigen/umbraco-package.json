{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Altigen.Web",
  "version": "1.0.0",
  "extensions": [

    {
      "type": "blockEditorCustomView",
      "alias": "Local.blockEditorCustomView.titleBlock",
      "name": "Block Editor Custom View for Title",
      "element": "/App_Plugins/Altigen/blockgrid/title-block.js",
      "forContentTypeAlias": "titleBlock",
      "forBlockEditor": "block-grid"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "Local.blockEditorCustomView.paragraphBlock",
      "name": "Block Editor Custom View for Paragraph",
      "element": "/App_Plugins/Altigen/blockgrid/paragraph-block.js",
      "forContentTypeAlias": "paragraphBlock",
      "forBlockEditor": "block-grid"
    }
  ]
}
