{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "738e6622-dfaa-4a93-89c2-ed1b8362237a",
        "UseHttps": true,
        "SanitizeTinyMce": true,
        "HideTopLevelNodeFromPath": true,
        "TimeOut": "00:20:00",
        "DefaultUILanguage": "tr-TR",

        "UmbracoCssPath": "~/assets/styles",
        "UmbracoScriptsPath": "~/assets/scripts",
        "UmbracoMediaPath": "~/assets/media",
        "IconsPath": "~/umbraco/assets/icons",

        "ReservedUrls": "~/.well-known/",
        "ReservedPaths": "~/app_plugins/,~/install/,~/mini-profiler-resources/,~/umbraco/"
      },
      "RequestHandler": {
        "AddTrailingSlash": true,
        "ConvertUrlsToAscii": "try",
        "ConvertFileNamesToAscii": "false",
        "EnableDefaultCharReplacements": true,
        "UserDefinedCharCollection": [
          {
            "Char": "ş",
            "Replacement": "s"
          },
          {
            "Char": "Ş",
            "Replacement": "s"
          },
          {
            "Char": "ı",
            "Replacement": "i"
          },
          {
            "Char": "İ",
            "Replacement": "i"
          },
          {
            "Char": "ç",
            "Replacement": "c"
          },
          {
            "Char": "Ç",
            "Replacement": "c"
          },
          {
            "Char": "ö",
            "Replacement": "o"
          },
          {
            "Char": "Ö",
            "Replacement": "o"
          },
          {
            "Char": "ü",
            "Replacement": "u"
          },
          {
            "Char": "Ü",
            "Replacement": "u"
          },
          {
            "Char": "ğ",
            "Replacement": "g"
          },
          {
            "Char": "Ğ",
            "Replacement": "g"
          },
          {
            "Char": "?",
            "Replacement": ""
          },
          {
            "Char": "!",
            "Replacement": ""
          },
          {
            "Char": ".",
            "Replacement": ""
          },
          {
            "Char": ":",
            "Replacement": ""
          },
          {
            "Char": ";",
            "Replacement": ""
          },
          {
            "Char": ",",
            "Replacement": ""
          },
          {
            "Char": "'",
            "Replacement": ""
          },
          {
            "Char": "\"",
            "Replacement": ""
          },
          {
            "Char": "(",
            "Replacement": ""
          },
          {
            "Char": ")",
            "Replacement": ""
          },
          {
            "Char": "&",
            "Replacement": ""
          },
          {
            "Char": "+",
            "Replacement": ""
          },
          {
            "Char": "#",
            "Replacement": ""
          },
          {
            "Char": "*",
            "Replacement": ""
          }
        ]
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "DeliveryApi": {
        "Enabled": true
      },
      "Runtime": {
        "Mode": "Production"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  }
}
